DATABASE_URL=postgres://tasks:tasks@localhost:5434/tasks
PUBLIC_URL=http://localhost:5180
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts routine tokens at rest. Required in production; any long random string.
SECRETS_KEY=
# Local only: point routine runs at the smoke test's fake server, and ping agents after 1s of quiet (default 120).
ROUTINE_API_BASE=http://localhost:4556
AGENT_QUIET_SECONDS=1
# Local only: enables email-only sign-in without Google. Never set in production.
DEV_LOGIN=1
# GitHub App (production: the app's values; the key as PEM in GITHUB_PRIVATE_KEY or base64 in GITHUB_PRIVATE_KEY_B64).
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY_B64=
# Local only: point at the smoke test's fake GitHub.
GITHUB_API_BASE=http://localhost:4559
GITHUB_WEB_BASE=http://localhost:4559

# Headless browser for in-house agents (Chromium is found automatically; local tests reach localhost)
# BROWSER_PATH=/usr/bin/chromium
BROWSER_ALLOW_LOOPBACK=1
